<?php

/**
 * @file
 * Functions to support theming in the SASS Starterkit subtheme.
 */

use Drupal\Core\Form\FormStateInterface;
use Drupal\file\FileInterface;
use Drupal\image\Entity\ImageStyle;
use Drupal\user\Entity\User;
use Drupal\Core\Cache\CacheableMetadata;
use Drupal\Core\Url;

/**
 * Implements hook_form_system_theme_settings_alter() for settings form.
 *
 * Replace Barrio setting options with subtheme ones.
 *
 * @param array<string, mixed> $form
 *   The form array.
 */
function tla_bootstrap_sass_form_system_theme_settings_alter(array &$form, FormStateInterface $form_state): void
{
  $form['components']['navbar']['bootstrap_barrio_navbar_top_background']['#options'] = array(
    'bg-primary' => t('Primary'),
    'bg-secondary' => t('Secondary'),
    'bg-light' => t('Light'),
    'bg-dark' => t('Dark'),
    'bg-white' => t('White'),
    'bg-transparent' => t('Transparent'),
  );
  $form['components']['navbar']['bootstrap_barrio_navbar_background']['#options'] = array(
    'bg-primary' => t('Primary'),
    'bg-secondary' => t('Secondary'),
    'bg-light' => t('Light'),
    'bg-dark' => t('Dark'),
    'bg-white' => t('White'),
    'bg-transparent' => t('Transparent'),
  );
}

/**
 * Implements hook_preprocess_HOOK() for menu.html.twig.
 *
 * @param array<string, mixed> $variables
 *   Theme variables.
 */
function tla_bootstrap_sass_preprocess_block(array &$variables): void
{
  // Upgrade only the bundled TLA logo, keeping custom uploaded logos intact.
  if (($variables['plugin_id'] ?? '') === 'system_branding_block' && !empty($variables['site_logo'])) {
    $image_path = base_path() . \Drupal::service('extension.list.theme')->getPath('tla_bootstrap_sass') . '/images/';
    $configured_path = parse_url((string) $variables['site_logo'], PHP_URL_PATH);
    if (in_array($configured_path, [$image_path . 'tla_logo_inverted.png', $image_path . 'tla_logo_inverted.webp'], TRUE)) {
      $variables['site_logo'] = $image_path . 'tla_logo_inverted.webp';
      $variables['tla_logo_optimized'] = TRUE;
    }
  }

  if ($variables['plugin_id'] === 'system_menu_block:account') {
    $user = User::load(\Drupal::currentUser()->id());
    if ($user && user_picture_enabled() && !$user->user_picture->isEmpty() && $user->user_picture->entity instanceof FileInterface) {
      $file = $user->user_picture->entity;
      $uri = $file->getFileUri();
      $style = \Drupal::entityTypeManager()->getStorage('image_style')->load('account_menu');
      $variables['picture'] = $style instanceof ImageStyle ? $style->buildUrl($uri) : \Drupal::service('file_url_generator')->generateString($uri);
      $variables['class'] = 'person';
      $cache_metadata = CacheableMetadata::createFromObject($file);
      $cache_metadata->applyTo($variables);
    } else {
      $variables['picture'] = base_path() . \Drupal::service('extension.list.theme')->getPath('tla_bootstrap_sass') . '/images/icon-w-user.svg';
      $variables['class'] = 'default';
    }
    // Force block cache rebuild for every user entity change.
    $variables['#cache']['contexts'][] = 'user';
  }
}

/**
 * Implements hook_form_alter().
 *
 * Add aria-label to search form for accessibility.
 *
 * @param array<string, mixed> $form
 *   The form array.
 */
function tla_bootstrap_sass_form_alter(array &$form, \Drupal\Core\Form\FormStateInterface $form_state, string $form_id): void
{
  // Check for the specific form ID.
  if (strpos($form_id, 'search_form') === 0) {
    // Check for the specific form element by name.
    if (isset($form['search-textfield'])) {
      // Add your attribute to the form element.
      $form['search-textfield']['#attributes']['aria-label'] = 'Enter search term';
    }
  }
}

/**
 * Implements hook_form_FORM_ID_alter() for the user login form.
 *
 * Supply the local panel even when flat_shib_auth is absent or unconfigured.
 * Module form alters run before theme alters, so retain an existing panel.
 */
function tla_bootstrap_sass_form_user_login_form_alter(array &$form, FormStateInterface $form_state): void
{
    if (isset($form['flat_shib_auth_local_login'])) {
        return;
    }

    // Keep the local credentials, submit button, and account-help links
    // together so the theme can render them as one panel.
    $local_login = [
        '#type' => 'container',
        '#attributes' => ['class' => ['flat-login-panel', 'flat-login-panel--local']],
        '#weight' => -100,
    ];

    $theme_path = \Drupal::service('extension.list.theme')->getPath('tla_bootstrap_sass');
    $local_login['branding'] = [
        '#type' => 'container',
        '#attributes' => ['class' => ['flat-login-panel__branding']],
        '#weight' => -200,
        'mpi_logo' => [
            '#theme' => 'image',
            '#uri' => Url::fromUri('base:' . $theme_path . '/images/mpi-logo.png')->toString(),
            '#alt' => t('Max Planck Institute for Psycholinguistics'),
            '#attributes' => ['class' => ['flat-login-panel__logo', 'flat-login-panel__logo--mpi']],
        ],
        'tla_logo' => [
            '#theme' => 'image',
            '#uri' => Url::fromUri('base:' . $theme_path . '/images/tla-logo-with-text.png')->toString(),
            '#alt' => t('The Language Archive'),
            '#attributes' => ['class' => ['flat-login-panel__logo', 'flat-login-panel__logo--site']],
        ],
    ];
    $local_login['introduction'] = [
        '#markup' => '<p class="flat-login-panel__introduction">' . t('Log in with your MPI for Psycholinguistics or The Language Archive account') . '</p>',
        '#weight' => -199,
    ];

    foreach (['name', 'pass', 'actions'] as $element) {
        if (isset($form[$element])) {
            $local_login[$element] = $form[$element];
            unset($form[$element]);
        }
    }

    // These inputs are read by core's login validation using their root form
    // keys. Wrapping them for presentation must not change their submitted
    // names or value paths.
    foreach (['name', 'pass'] as $element) {
        if (isset($local_login[$element])) {
            $local_login[$element]['#parents'] = [$element];
        }
    }

    // The default password field description is replaced with the clearly
    // labelled account links below the submit button.
    if (isset($local_login['pass']['#description'])) {
        unset($local_login['pass']['#description']);
    }

    $local_login['account_links'] = [
        '#type' => 'container',
        '#attributes' => ['class' => ['flat-login-panel__account-links']],
        '#weight' => 200,
        'register' => [
            '#type' => 'link',
            '#title' => t('Create new account'),
            '#url' => Url::fromRoute('user.register'),
        ],
        'password' => [
            '#type' => 'link',
            '#title' => t('Reset your password'),
            '#url' => Url::fromRoute('user.pass'),
        ],
    ];

    $form['flat_shib_auth_local_login'] = $local_login;

}

/**
 * Implements hook_preprocess_page_title().
 */
function tla_bootstrap_sass_preprocess_page_title(array &$variables): void
{
    if (!in_array(\Drupal::routeMatch()->getRouteName(), ['user.register', 'user.pass'], TRUE)) {
        return;
    }

    // Reuse the module's key to avoid rendering the same link twice.
    if (!isset($variables['title_prefix']['flat_shib_auth_back_to_login'])) {
        $variables['title_prefix']['flat_shib_auth_back_to_login'] = [
            '#type' => 'container',
            '#attributes' => ['class' => ['flat-account-page__back-link']],
            'back' => [
                '#type' => 'link',
                '#title' => t('< back to login page'),
                '#url' => \Drupal\Core\Url::fromRoute('user.login'),
            ],
        ];
    }
}

/**
 * Implements hook_preprocess_page().
 *
 * Hands the page templates the content of the archive footer.
 *
 * @param array<string, mixed> $variables
 *   Theme variables.
 */
function tla_bootstrap_sass_preprocess_page(array &$variables): void
{
  $variables['archive_footer'] = tla_bootstrap_sass_archive_footer();
}

/**
 * Builds the content of the archive footer.
 *
 * The footer (templates/layout/archive-footer.html.twig) is the same bar on
 * every archive site; what differs is the line above the address, the links
 * and whether the UNESCO Memory of the World logo is there. The defaults are
 * The Language Archive's. A theme built on this one passes what differs, from
 * its own hook_preprocess_page():
 *
 * @code
 * $variables['archive_footer'] = tla_bootstrap_sass_archive_footer([
 *   'name' => NULL,
 *   'memory_of_the_world' => FALSE,
 * ]);
 * @endcode
 *
 * The links are paths below the site's own base path, so a site that lives at
 * /mpi links to /mpi/privacy-policy. The pages themselves are content: create
 * them with these aliases, or the links lead to a "page not found".
 *
 * @param array<string, mixed> $overrides
 *   Keys to replace: name, address (a list of lines), links (a list of title
 *   and path), memory_of_the_world (a boolean).
 *
 * @return array<string, mixed>
 *   The values for the footer template, with the link URLs and the folder of
 *   the logos added.
 */
function tla_bootstrap_sass_archive_footer(array $overrides = []): array
{
  $footer = $overrides + [
    'name' => t('The Language Archive'),
    'address' => [
      'Max Planck Institute for Psycholinguistics',
      'Wundtlaan 1',
      '6525XD Nijmegen',
      'The Netherlands',
    ],
    'links' => [
      ['title' => t('Mission'), 'path' => '/mission'],
      ['title' => t('People'), 'path' => '/people'],
      ['title' => t('Privacy Policy'), 'path' => '/privacy-policy'],
      ['title' => t('Terms of Use'), 'path' => '/terms-of-use'],
    ],
    'memory_of_the_world' => TRUE,
  ];
  foreach ($footer['links'] as &$link) {
    $link['url'] = (string) Url::fromUserInput($link['path'])->toString();
  }
  unset($link);
  $footer['images'] = base_path()
    . \Drupal::service('extension.list.theme')->getPath('tla_bootstrap_sass')
    . '/images/footer';
  return $footer;
}
